# Dane istniejącego użytkownika i bazy PostgreSQL w Cloud SQL.
# Hasło ze znakami specjalnymi musi być zakodowane w URL (percent-encoding).
DATABASE_URL=postgresql://UZYTKOWNIK:HASLO@127.0.0.1:5433/NAZWA_BAZY

# Lokalne Application Default Credentials dla Cloud SQL Auth Proxy.
CLOUD_SQL_CREDENTIALS_FILE=${HOME}/.config/gcloud/application_default_credentials.json
# UID i GID użytkownika będącego właścicielem pliku z poświadczeniami.
CLOUD_SQL_PROXY_UID=1000
CLOUD_SQL_PROXY_GID=1000

# Wygeneruj własny klucz: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dane klienta OAuth typu Web application w Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Przekierowanie po zalogowaniu; dla HTTPS ustaw COOKIE_SECURE=true
FRONTEND_URL=http://localhost:3000/
COOKIE_SECURE=false

# Google Gemini API Key (dla chatbota Roberta Biznesu, RAG i czatu głosowego TTS)
GEMINI_API_KEY=

# Upload MP4 do aktywności. Bez tokenu endpoint zapisu filmów pozostaje wyłączony.
CONTENT_ADMIN_TOKEN=
# Maksymalny rozmiar pojedynczego pliku MP4 w bajtach (domyślnie 100 MiB).
MAX_VIDEO_UPLOAD_BYTES=104857600
# Ustaw None, gdy frontend i API działają na różnych domenach.
COOKIE_SAMESITE=Lax

# Dozwolony origin frontendu dla zapytań przeglądarki, np. https://app.example.com.
# Lokalnie frontend (port 3000) i API (port 5000) mają różne originy.
FRONTEND_ORIGIN=http://localhost:3000

# Cloud Run: zamiast DATABASE_URL ustaw te wartości. Cloud Run udostępnia socket
# po użyciu --add-cloudsql-instances encoded-breaker-515313-h9:us-east1:shark-finance-db.
INSTANCE_UNIX_SOCKET=/cloudsql/encoded-breaker-515313-h9:us-east1:shark-finance-db
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
